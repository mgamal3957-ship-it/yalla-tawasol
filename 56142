<input id="nameInput" type="text" placeholder="اسمك">
<input id="passInput" type="password" placeholder="كلمة السر">
<button onclick="login()">دخول / انشاء حساب</button>
<p style="color:white;font-size:13px;text-align:center">لو اول مرة ليك، هنعملك حساب جديد بالباسورد ده<br>لو مسجل قبل كده، اكتب نفس الباسورد عشان تدخل</p>
<p id="loginError" style="color:white;font-weight:bold;text-align:center"></p>
</div>

<div id="mainScreen">
<div class="topbar"><button onclick="openSettings()">⚙️</button><b>دردشة</b><button onclick="openRequests()">📩<span id="mailDot"></span></button></div>
<div class="search"><input id="searchInput" placeholder="دور بالاسم او الرقم" oninput="renderFriends(this.value)"><button onclick="searchFriend()">🔍</button></div>
<div id="friendsList"></div>
</div>

<div id="chatScreen">
<div class="chat-top"><button onclick="backToList()">⬅</button><b id="chatWithName"></b></div>
<div id="messages"></div>
<div class="chat-input"><input id="msgInput" placeholder="اكتب رسالة..."><button onclick="sendMessage()">➤</button></div>
</div>

<div id="requestsBox" class="popup"><div class="popup-box"><h3 style="text-align:center">طلبات الصداقة</h3><div id="requestsList"></div><button onclick="closeRequests()" style="background:#888;width:100%">إغلاق</button></div></div>
<div id="settingsBox" class="popup"><div class="popup-box" style="text-align:center"><h3>إعداداتي</h3><p style="margin:15px">رقمك: <b id="myNumber"></b></p><p style="margin:15px">اسمك: <b id="myName"></b></p><p style="margin:15px">كلمة السر: <b id="myPass"></b> <span onclick="togglePass()" style="cursor:pointer">👁️</span></p><button onclick="logout()" style="background:#ff3b30">تسجيل خروج</button><button onclick="closeSettings()" style="background:#888">إغلاق</button></div></div>

