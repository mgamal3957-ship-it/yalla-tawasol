#loginScreen input{width:90%;max-width:350px;padding:15px;border:none;border-radius:15px;text-align:center;font-size:18px;outline:none}
#loginScreen button{width:90%;max-width:350px;padding:15px;background:#004d40;color:white;border:none;border-radius:15px;font-size:18px;font-weight:bold;cursor:pointer}
