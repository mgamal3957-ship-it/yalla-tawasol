.topbar{background:#00c853;color:white;padding:15px;display:flex;justify-content:space-between;align-items:center}
.topbar button{background:rgba(255,255,255,0.2);border:none;color:white;padding:8px 12px;border-radius:10px;cursor:pointer;font-size:18px;position:relative}
#mailDot{position:absolute;top:2px;left:2px;width:10px;height:10px;background:yellow;border-radius:50%;display:none}
.search{padding:10px;display:flex;gap:5px}
.search input{flex:1;padding:12px;border:1px solid #ddd;border-radius:10px}
.search button{background:#00c853;color:white;border:none;padding:0 20px;border-radius:10px}
#friendsList{flex:1;overflow-y:auto}
.friend{display:flex;justify-content:space-between;align-items:center;padding:15px;border-bottom:1px solid #eee}
.friend button{background:#00c853;color:white;border:none;padding:8px 15px;border-radius:15px}
.add-btn{background:#00c853 !important;font-size:20px !important;width:35px;height:35px;border-radius:50% !important}
#chatScreen{display:none;height:100vh;flex-direction:column;background:#e5ddd5}
.chat-top{background:#00c853;color:white;padding:15px;display:flex;gap:10px;align-items:center}
.chat-top button{background:none;border:none;color:white;font-size:20px}
#messages{flex:1;padding:10px;overflow-y:auto;display:flex;flex-direction:column;gap:8px}
.msg{background:white;padding:10px;border-radius:10px;max-width:80%;align-self:flex-start}
.msg.me{background:#dcf8c6;align-self:flex-end}
.msg small{display:block;font-size:10px;color:#888;margin-top:5px}
.chat-input{display:flex;padding:10px;background:white;gap:5px}
.chat-input input{flex:1;padding:12px;border:1px solid #ddd;border-radius:20px;outline:none}
.chat-input button{background:#00c853;color:white;border:none;padding:0 20px;border-radius:20px}
.popup{position:fixed;inset:0;background:rgba(0,0,0,0.5);display:none;z-index:99}
.popup-box{background:white;margin:60px 15px;padding:20px;border-radius:15px;max-height:80vh;overflow-y:auto}
.popup-box button{padding:10px 15px;border:none;border-radius:10px;color:white;margin:5px;cursor:pointer}
.req-card{border:1px solid #eee;padding:15px;border-radius:10px;margin-bottom:10px;text-align:center}
</style>
</head>
